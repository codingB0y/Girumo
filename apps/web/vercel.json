{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/emails",
      "schedule": "7 11-23 * * *"
    },
    {
      "path": "/api/notifications/alerts",
      "schedule": "17 11-23/3 * * *"
    },
    {
      "path": "/api/cron/bling",
      "schedule": "*/5 * * * *"
    }
  ]
}
