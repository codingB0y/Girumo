{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/emails",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/notifications/alerts",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/group-invites",
      "schedule": "*/10 * * * *"
    }
  ]
}
