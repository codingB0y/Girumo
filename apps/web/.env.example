# HUBFLOW Web - exemplo de ambiente
# Copie para .env.local e preencha os valores reais.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SALES_WHATSAPP_URL=
AUTH_SECRET=gere-um-segredo-longo

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# Redis opcional para filas futuras
REDIS_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_ESSENCIAL=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PERFORMANCE_MAX=price_xxx

# Engine Baileys
ENGINE_TOKEN=gere-um-token-aleatorio-compartilhado-com-a-engine

# Compatibilidade temporaria com stores JSON/NDJSON ainda nao migrados
HUBFLOW_DATA_DIR=./data
