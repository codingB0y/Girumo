# ============================================
# HUBFLOW — AMBIENTE PRODUÇÃO (EXEMPLO)
# ============================================
# ⚠️  NUNCA usar este arquivo localmente
# ⚠️  Valores reais ficam APENAS na Vercel/Coolify
# ⚠️  Este arquivo é apenas referência de quais vars são necessárias
# ============================================

# --- Ambiente ---
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
# Manter o host atual; trocar somente após aquisição e validação jurídica do domínio Girumo.
NEXT_PUBLIC_SITE_URL=https://hubflow.com.br
NEXT_PUBLIC_APP_URL=https://app.hubflow.com.br
NEXT_PUBLIC_SALES_WHATSAPP_URL=https://wa.me/55XXXXXXXXXXX
AUTH_SECRET=<GERAR_SECRET_FORTE_64_CHARS>

# --- Supabase PRODUÇÃO ---
NEXT_PUBLIC_SUPABASE_URL=https://PROJETO-PROD.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY_PROD>
SUPABASE_URL=https://PROJETO-PROD.supabase.co
SUPABASE_ANON_KEY=<ANON_KEY_PROD>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY_PROD>

# --- Stripe LIVE MODE ---
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_live_XXXXXXXXXXXXXXX
STRIPE_PRICE_ESSENCIAL=price_XXXXXXXXXXXXXXX
STRIPE_PRICE_GROWTH=price_XXXXXXXXXXXXXXX
STRIPE_PRICE_PERFORMANCE_MAX=price_XXXXXXXXXXXXXXX

# --- Engine WhatsApp PRODUÇÃO ---
ENGINE_URL=https://engine.hubflow.com.br
ENGINE_TOKEN=<TOKEN_PROD_FORTE>
ENGINE_MODE=production

# --- Admin ---
PLATFORM_ADMIN_EMAILS=igor@hubflow.com.br,admin@hubflow.com.br

# --- Feature Flags ---
HUBFLOW_USE_SUPABASE=1
ENABLE_DEV_TOOLS=false
ENABLE_MOCK_ENGINE=false
BLOCK_PRODUCTION_CONNECTIONS=false

# --- Data dir (legacy fallback) ---
HUBFLOW_DATA_DIR=./data
