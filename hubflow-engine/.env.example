# HUBFLOW Engine - exemplo de ambiente

# HTTP
PORT=3001

# Web/API callbacks legados enquanto a migracao para Supabase queue termina
APP_URL=http://localhost:3000
ENGINE_TOKEN=troque-este-token

# Supabase command/event queue
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...
ENGINE_COMMAND_POLL_MS=3000
ENGINE_COMMAND_BATCH_SIZE=5
ENGINE_STATE_FILE=engine-state.json

# Backup cifrado de auth/ + engine-state.json (scripts/backup-auth.js → Supabase Storage).
# GUARDE a passphrase FORA do Supabase. Reusa SUPABASE_URL/SERVICE_ROLE_KEY acima.
BACKUP_PASSPHRASE=troque-por-uma-passphrase-forte
# BACKUP_BUCKET=engine-backups   # opcional (default engine-backups, criado no 1o run)
# BACKUP_RETENTION=14            # opcional (mantem os N backups mais novos)
