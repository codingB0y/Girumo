{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "HubFlow Web (Next.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--workspace",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "HubFlow Engine (Baileys/Express)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "hubflow-engine/index.js"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "Girumo LP v2 (worktree)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        ".worktrees/girumo-lp-v2/apps/web",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Girumo Relampago (worktree)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/Users/Igor/Desktop/girumo-relampago/apps/web",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
