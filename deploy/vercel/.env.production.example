# Girumo Web - Vercel production env

# Domínio Girumo em produção desde 12/ago/2026. O host antigo segue na denylist
# PROD_DOMAINS enquanto resolver, para dev/staging não apontar pra ele por engano.
NEXT_PUBLIC_SITE_URL=https://girumo.com.br
NEXT_PUBLIC_APP_URL=https://app.girumo.com.br
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SALES_WHATSAPP_URL=https://wa.me/55DDDNUMERO?text=Oi%2C%20quero%20conhecer%20a%20Girumo
AUTH_SECRET=gere-um-segredo-longo

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

STRIPE_SECRET_KEY=sk_live_ou_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_ou_test_xxx
STRIPE_PRICE_ESSENCIAL=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PERFORMANCE_MAX=price_xxx

ENGINE_TOKEN=mesmo-token-configurado-no-coolify
CRON_SECRET=gere-um-segredo-com-no-minimo-24-caracteres
HUBFLOW_DATA_DIR=./data

# --- Evolution API (F2) ---
# URL publica da stack no Coolify. O worker (F4) usa http://evolution:8080
# pela rede interna docker; a Vercel precisa do HTTPS publico.
EVOLUTION_API_URL=https://wa.seudominio.com
# Mesmo valor de AUTHENTICATION_API_KEY na stack. Credencial de admin: cria e
# apaga qualquer instancia. Server-side apenas, nunca NEXT_PUBLIC_.
EVOLUTION_API_KEY=mesmo-valor-do-AUTHENTICATION_API_KEY
# Enviado no header x-evolution-webhook-secret ao registrar o webhook e
# conferido em tempo constante no receiver. Minimo 32 caracteres.
EVOLUTION_WEBHOOK_SECRET=gere-um-segredo-com-no-minimo-32-caracteres

# Para onde vai o aviso de "pediu demonstração" em /demo. Sem isto o lead é
# gravado em demo_requests mas ninguém é avisado na hora.
SALES_NOTIFICATION_EMAIL=
