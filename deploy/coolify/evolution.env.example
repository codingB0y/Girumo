# Evolution API stack (Coolify) — SERVER-ONLY. Nunca no frontend / NEXT_PUBLIC_.
# Copie para as variaveis do app Coolify (nao comitar valores reais).

# Tag da imagem — PINADA. Verifique no Docker Hub antes do deploy.
EVOLUTION_IMAGE_TAG=v2.3.7

# URL publica HTTPS da API (dominio no proxy do Coolify).
SERVER_URL=https://wa.seudominio.com

# Chave global da Evolution (>=32 bytes). MESMO valor que EVOLUTION_API_KEY na Vercel/worker.
# Gerar: openssl rand -hex 32
AUTHENTICATION_API_KEY=troque-por-32-bytes-aleatorios

# Postgres interno da stack (sem porta exposta).
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=troque-senha-forte
EVOLUTION_DB_NAME=evolution

# Redis interno da stack.
EVOLUTION_REDIS_DB=6

# Log (ERROR em producao).
LOG_LEVEL=ERROR
