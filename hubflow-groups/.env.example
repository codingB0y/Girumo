# Copie para .env.local e ajuste. Sem isto, usa defaults (NÃO use em produção).

# Senha de acesso ao painel.
APP_PASSWORD=troque-esta-senha

# Token compartilhado app<->engine (a engine envia no header x-engine-token).
# Rode a engine com o MESMO valor: ENGINE_TOKEN=... node index.js
ENGINE_TOKEN=gere-um-token-aleatorio

# Segredo p/ assinar o cookie de sessão (HMAC). Gere algo longo e aleatório.
AUTH_SECRET=gere-um-segredo-aleatorio-longo

# Postgres (domínio de contas/billing). Prisma lê DATABASE_URL do .env (não do .env.local).
# Local via Docker ou hospedado (Neon/Supabase free tier). Ex.:
DATABASE_URL=postgresql://user:senha@localhost:5432/devzap?schema=public

# Asaas (pagamento) — fatia futura. Chave da conta + segredo do webhook.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
